# Database
MONGODB_URI=mongodb://localhost:27017/elora-art
MONGODB_TEST_URI=mongodb://localhost:27017/elora-art-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Drive API
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=your-root-folder-id

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# API Configuration
API_PORT=3001
API_HOST=localhost
API_BASE_URL=http://localhost:3001

# Web Portal
WEB_PORT=3000
WEB_HOST=localhost
NEXT_PUBLIC_API_URL=http://localhost:3001

# Admin Portal
ADMIN_PORT=3002
ADMIN_HOST=localhost
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Drive Folder Structure
GDRIVE_ORDERS_FOLDER=Orders
GDRIVE_MEASUREMENTS_FOLDER=Measurements
GDRIVE_INSTALLATIONS_FOLDER=Installations
GDRIVE_REPORTS_FOLDER=Reports