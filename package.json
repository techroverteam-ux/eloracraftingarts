{
  "name": "EloraCraftingArts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "pod_install": "cd ios && pod install && cd ..",
    "clean": "cd android && ./gradlew clean && cd .. && npx react-native-clean-project",
    "clean:cache": "rm -rf /tmp/metro-* /tmp/haste-* && watchman watch-del-all",
    "clean:all": "npm run clean:cache && npm run clean && rm -rf node_modules && bun install",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:android": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "logs:android": "adb logcat *:S ReactNative:V ReactNativeJS:V",
    "dev": "npm run start:reset"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.3",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "axios": "^0.27.2",
    "lucide-react-native": "^0.400.0",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-crypto-js": "^1.0.0",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.18.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.4.4",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-screens": "^3.34.0",
    "react-native-share": "^12.2.5",
    "react-native-svg": "13.4.0",
    "react-native-toast-message": "^2.1.6",
    "react-native-vector-icons": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.73.18",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  }
}
